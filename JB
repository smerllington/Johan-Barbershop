<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Johan Barbershop | Agenda tu cita</title>
  <style>
    :root{
      --bg:#0e0e0f;
      --panel:#171719;
      --panel2:#202023;
      --gold:#d8aa55;
      --gold2:#f1ce83;
      --cream:#f7f0e2;
      --muted:#aaa6a0;
      --green:#6fcf97;
      --red:#e77b7b;
      --border:rgba(216,170,85,.25);
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
      background:
        radial-gradient(circle at 15% 10%,rgba(216,170,85,.12),transparent 30%),
        radial-gradient(circle at 90% 80%,rgba(216,170,85,.08),transparent 28%),
        var(--bg);
      color:var(--cream);
      min-height:100vh;
    }
    header{
      padding:28px 7%;
      display:flex;
      justify-content:space-between;
      align-items:center;
      border-bottom:1px solid var(--border);
      background:rgba(14,14,15,.85);
      backdrop-filter:blur(12px);
      position:sticky;top:0;z-index:5;
    }
    .brand{display:flex;align-items:center;gap:14px}
    .logo{
      width:46px;height:46px;border:1px solid var(--gold);
      border-radius:50%;display:grid;place-items:center;color:var(--gold);
      font-weight:800;font-size:19px;
    }
    .brand h1{margin:0;font-family:Georgia,serif;font-size:22px}
    .brand span{display:block;color:var(--gold2);font-size:11px;letter-spacing:2px;text-transform:uppercase;margin-top:3px}
    .hero{padding:64px 7% 35px;text-align:center}
    .hero .eyebrow{color:var(--gold2);letter-spacing:4px;font-size:12px;text-transform:uppercase}
    .hero h2{font-family:Georgia,serif;font-size:clamp(38px,6vw,70px);margin:14px 0 10px}
    .hero p{color:var(--muted);max-width:620px;margin:auto;font-size:16px;line-height:1.7}
    main{max-width:1100px;margin:0 auto;padding:25px 7% 70px}
    .grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}
    .card{
      background:linear-gradient(145deg,rgba(32,32,35,.95),rgba(18,18,20,.98));
      border:1px solid var(--border);border-radius:22px;padding:26px;
      box-shadow:0 18px 50px rgba(0,0,0,.25);
    }
    .card h3{margin:0 0 20px;font-family:Georgia,serif;font-size:25px}
    .services{display:grid;gap:12px}
    .service{
      border:1px solid rgba(255,255,255,.08);background:#19191b;
      border-radius:15px;padding:16px;display:flex;align-items:center;
      justify-content:space-between;cursor:pointer;transition:.2s;
    }
    .service:hover,.service.selected{border-color:var(--gold);transform:translateY(-1px)}
    .service.selected{background:rgba(216,170,85,.09)}
    .service strong{display:block}.service small{color:var(--muted)}
    .price{color:var(--gold2);font-weight:800;white-space:nowrap}
    label{display:block;color:#d8d4cd;font-size:13px;margin:17px 0 8px}
    input,select{
      width:100%;padding:14px 15px;border-radius:12px;border:1px solid rgba(255,255,255,.12);
      background:#111113;color:var(--cream);font-size:15px;outline:none;
    }
    input:focus,select:focus{border-color:var(--gold)}
    .times{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:8px}
    .time{
      padding:11px 7px;border-radius:10px;border:1px solid rgba(255,255,255,.1);
      background:#111113;color:#eee;cursor:pointer;
    }
    .time:hover,.time.selected{background:var(--gold);color:#111;border-color:var(--gold);font-weight:800}
    .time.unavailable{opacity:.3;cursor:not-allowed;text-decoration:line-through}
    .summary{
      margin-top:22px;padding:17px;border-radius:14px;background:#101012;
      border:1px dashed var(--border);line-height:1.7;color:#d9d5cd
    }
    .summary b{color:var(--gold2)}
    .cta{
      width:100%;margin-top:17px;padding:15px;border:0;border-radius:12px;
      background:linear-gradient(90deg,var(--gold),var(--gold2));color:#111;
      font-weight:900;font-size:16px;cursor:pointer;
    }
    .cta:hover{filter:brightness(1.06)}
    .notice{
      display:none;margin-top:20px;padding:18px;border-radius:15px;
      border:1px solid rgba(111,207,151,.35);background:rgba(111,207,151,.08);
    }
    .notice.show{display:block}
    .notice strong{color:var(--green);font-size:17px}
    #countdown{margin-top:6px;color:#ddd}
    footer{text-align:center;padding:28px;color:#777;border-top:1px solid rgba(255,255,255,.06);font-size:13px}
    .empty{color:var(--muted);font-size:14px;text-align:center;padding:12px}
    @media(max-width:760px){
      header{padding:20px 5%}.grid{grid-template-columns:1fr}.hero{padding:48px 5% 25px}main{padding:20px 5% 55px}
      .times{grid-template-columns:repeat(2,1fr)}
    }
  </style>
</head>
<body>
<header>
  <div class="brand">
    <div class="logo">JB</div>
    <div>
      <h1>Johan Barbershop</h1>
      <span>Estilo • Precisión • Confianza</span>
    </div>
  </div>
</header>

<section class="hero">
  <div class="eyebrow">Reserva tu momento</div>
  <h2>Agenda tu cita</h2>
  <p>Elige tu servicio, selecciona la fecha y horario que prefieras y deja que nosotros nos encarguemos del resto.</p>
</section>

<main>
  <div class="grid">
    <section class="card">
      <h3>1. Elige tu servicio</h3>
      <div class="services" id="services">
        <div class="service" data-name="Cejas" data-price="150">
          <div><strong>Cejas</strong><small>Diseño y arreglo</small></div><div class="price">DOP 150</div>
        </div>
        <div class="service" data-name="Corte hombre" data-price="500">
          <div><strong>Corte hombre</strong><small>Corte clásico o moderno</small></div><div class="price">DOP 500</div>
        </div>
        <div class="service" data-name="Corte niño" data-price="300">
          <div><strong>Corte niño</strong><small>Para los más pequeños</small></div><div class="price">DOP 300</div>
        </div>
        <div class="service" data-name="Corte adolescente" data-price="400">
          <div><strong>Corte adolescente</strong><small>Estilo a tu medida</small></div><div class="price">DOP 400</div>
        </div>
      </div>
    </section>

    <section class="card">
      <h3>2. Fecha y horario</h3>
      <label for="date">Selecciona una fecha</label>
      <input type="date" id="date">
      <label>Horarios disponibles</label>
      <div class="times" id="times"></div>
      <div class="summary">
        <div>Servicio: <b id="sumService">No seleccionado</b></div>
        <div>Fecha: <b id="sumDate">—</b></div>
        <div>Hora: <b id="sumTime">—</b></div>
        <div>Total: <b id="sumPrice">DOP 0</b></div>
      </div>
      <button class="cta" id="book">Confirmar mi cita</button>
      <div class="notice" id="notice">
        <strong>✓ Cita agendada correctamente</strong>
        <div id="confirmation"></div>
        <div id="countdown"></div>
      </div>
    </section>
  </div>
</main>

<footer>© 2026 Johan Barbershop · Agenda tu estilo</footer>

<script>
  const services = document.querySelectorAll('.service');
  const dateInput = document.getElementById('date');
  const timesBox = document.getElementById('times');
  const sumService = document.getElementById('sumService');
  const sumDate = document.getElementById('sumDate');
  const sumTime = document.getElementById('sumTime');
  const sumPrice = document.getElementById('sumPrice');
  const notice = document.getElementById('notice');
  const confirmation = document.getElementById('confirmation');
  const countdown = document.getElementById('countdown');

  let selectedService = null;
  let selectedTime = null;
  let reminderTimer = null;

  // Horarios de ejemplo. Puedes modificarlos fácilmente.
  const availableTimes = [
    '9:00 AM','9:30 AM','10:00 AM','10:30 AM',
    '11:00 AM','11:30 AM','12:00 PM','12:30 PM',
    '1:00 PM','2:00 PM','2:30 PM','3:00 PM',
    '3:30 PM','4:00 PM','4:30 PM','5:00 PM',
    '5:30 PM','6:00 PM','6:30 PM'
  ];

  // La fecha mínima es hoy.
  const today = new Date();
  const yyyy = today.getFullYear();
  const mm = String(today.getMonth()+1).padStart(2,'0');
  const dd = String(today.getDate()).padStart(2,'0');
  dateInput.min = `${yyyy}-${mm}-${dd}`;
  dateInput.value = `${yyyy}-${mm}-${dd}`;

  function renderTimes(){
    timesBox.innerHTML = '';
    selectedTime = null;
    sumTime.textContent = '—';

    availableTimes.forEach((time, i) => {
      const button = document.createElement('button');
      button.className = 'time';
      button.type = 'button';
      button.textContent = time;

      // Simula algunos horarios ocupados.
      const dateValue = dateInput.value || '';
      const occupied = (i === 2 || i === 9) && dateValue.endsWith('1');
      if(occupied){
        button.classList.add('unavailable');
        button.disabled = true;
      }

      button.addEventListener('click',()=>{
        document.querySelectorAll('.time').forEach(x=>x.classList.remove('selected'));
        button.classList.add('selected');
        selectedTime = time;
        sumTime.textContent = time;
      });
      timesBox.appendChild(button);
    });
  }

  services.forEach(service=>{
    service.addEventListener('click',()=>{
      services.forEach(x=>x.classList.remove('selected'));
      service.classList.add('selected');
      selectedService = {
        name: service.dataset.name,
        price: Number(service.dataset.price)
      };
      sumService.textContent = selectedService.name;
      sumPrice.textContent = `DOP ${selectedService.price.toLocaleString('es-DO')}`;
    });
  });

  dateInput.addEventListener('change',()=>{
    const date = new Date(dateInput.value + 'T12:00:00');
    sumDate.textContent = date.toLocaleDateString('es-DO',{
      weekday:'long',year:'numeric',month:'long',day:'numeric'
    });
    renderTimes();
  });

  // Mostrar la fecha inicial.
  dateInput.dispatchEvent(new Event('change'));

  function timeToDate(dateString, timeString){
    const match = timeString.match(/(\d+):(\d+)\s(AM|PM)/);
    if(!match) return null;
    let h = Number(match[1]);
    const m = Number(match[2]);
    const period = match[3];
    if(period === 'PM' && h !== 12) h += 12;
    if(period === 'AM' && h === 12) h = 0;
    const d = new Date(dateString + 'T00:00:00');
    d.setHours(h,m,0,0);
    return d;
  }

  function startReminder(appointmentDate){
    if(reminderTimer) clearInterval(reminderTimer);

    const reminderAt = new Date(appointmentDate.getTime() - 20*60*1000);
    const check = ()=>{
      const now = new Date();
      const remaining = reminderAt - now;

      if(remaining <= 0 && remaining > -60000){
        countdown.textContent = 'Ya casi es su turno. ¡Te esperamos en Johan Barbershop!';
        if('Notification' in window && Notification.permission === 'granted'){
          new Notification('Johan Barbershop', {
            body:'Ya casi es su turno. ¡Te esperamos!'
          });
        }
        clearInterval(reminderTimer);
        return;
      }

      if(remaining > 0){
        const totalMinutes = Math.floor(remaining/60000);
        const hours = Math.floor(totalMinutes/60);
        const mins = totalMinutes%60;
        countdown.textContent = `Recordatorio: “Ya casi es su turno” en ${hours ? hours+' h ' : ''}${mins} min.`;
      }
    };
    check();
    reminderTimer = setInterval(check,30000);
  }

  document.getElementById('book').addEventListener('click', async ()=>{
    if(!selectedService) return alert('Selecciona un servicio.');
    if(!dateInput.value) return alert('Selecciona una fecha.');
    if(!selectedTime) return alert('Selecciona un horario.');

    const appointmentDate = timeToDate(dateInput.value, selectedTime);
    const now = new Date();
    if(appointmentDate <= now) return alert('Ese horario ya pasó. Selecciona otro.');

    if('Notification' in window && Notification.permission === 'default'){
      try { await Notification.requestPermission(); } catch(e){}
    }

    const formattedDate = appointmentDate.toLocaleDateString('es-DO',{
      weekday:'long',year:'numeric',month:'long',day:'numeric'
    });
    confirmation.textContent = `Tu cita para ${selectedService.name} está reservada para el ${formattedDate} a las ${selectedTime}.`;
    notice.classList.add('show');
    startReminder(appointmentDate);
    notice.scrollIntoView({behavior:'smooth',block:'nearest'});
  });
</script>
</body>
</html>
